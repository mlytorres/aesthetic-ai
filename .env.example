APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI — OpenAI image generation for AI simulation (gpt-image-1)
# Required when FEATURE_AI_VISION=true. Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=

FEATURE_AI_VISION=false
FEATURE_LEAD_SCORING=false
FEATURE_NOTIFICATIONS=false
FEATURE_SMS_ENABLED=false

# Twilio SMS
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Daily.co — HIPAA-eligible video consultations (https://www.daily.co)
# Get your API key from: https://dashboard.daily.co/developers
DAILY_API_KEY=


TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ─── Stripe Billing ────────────────────────────────────────────────────────────
# Obtain keys from https://dashboard.stripe.com/apikeys
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
# Webhook secret from https://dashboard.stripe.com/webhooks (add endpoint: /stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe Price IDs — create products in Stripe dashboard, then paste the price IDs here.
# Test mode: price_xxx  |  Live mode: price_xxx
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# ─── Laravel Nightwatch ────────────────────────────────────────────────────────
# Obtain token from https://nightwatch.laravel.com/
NIGHTWATCH_TOKEN=
NIGHTWATCH_ENABLED=true

# Sampling rates (0.0–1.0). Production defaults set in config/nightwatch.php.
# Temporarily set REQUEST to 1.0 when debugging specific request issues.
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.10
NIGHTWATCH_COMMAND_SAMPLE_RATE=1.0
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0
NIGHTWATCH_SCHEDULED_TASK_SAMPLE_RATE=1.0

# HIPAA: request payload capture is OFF by default. Do not enable without legal review.
NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD=false

# Log level shipped to Nightwatch (warning|error|critical in production)
NIGHTWATCH_LOG_LEVEL=warning

# ─── Social Authentication ───────────────────────────────────────────────────
# Obtain keys from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
